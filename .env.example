# Cloudflare Workers + D1 開発用設定
# wrangler dev --env-file .env で読み込み

# デプロイ時は wrangler secret で設定:
#   echo "＜値＞" | bun x wrangler secret put SESSION_SECRET
#   echo "＜値＞" | bun x wrangler secret put GOOGLE_CLIENT_SECRET
# wrangler.toml [vars] で設定:
#   GOOGLE_CLIENT_ID, GOOGLE_REDIRECT_URI

SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars!!

# Google OAuth（開発用 = localhost）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google
